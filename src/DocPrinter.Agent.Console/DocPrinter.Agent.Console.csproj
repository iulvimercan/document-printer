<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DocPrinter.Agent.Console</RootNamespace>
    <AssemblyName>DocPrinter.Agent.Console</AssemblyName>
    <!-- Shares the Web project's secret store so one 'dotnet user-secrets set' serves both. -->
    <UserSecretsId>2893dafc-5225-494c-bbd5-c724c94dd4b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocPrinter.Agent\DocPrinter.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.6" />
  </ItemGroup>

</Project>
